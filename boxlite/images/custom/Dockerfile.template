# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=xensemble/box-base:bookworm
FROM ${BASE_IMAGE}

ENV PATH="/usr/local/bin:/root/.local/bin:${PATH}" HOME="/root"

