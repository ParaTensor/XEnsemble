{
  "name": "agent-backend",
  "version": "1.2.0",
  "description": "Enterprise-level heterogeneous Agent Web hosting platform (Node.js MVP)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "manage-user": "node scripts/manage-user.js",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "build:gateway": "cargo build --release --manifest-path ../gateway/Cargo.toml",
    "test": "node --test src/llm/*.test.js",
    "test:llm-acceptance": "RUN_LLM_ACCEPTANCE=1 node --test src/llm/proxy.acceptance.test.js",
    "gateway": "UNIGATEWAY_CONFIG_PATH=./data/unigateway.toml UNIGATEWAY_BIND_ADDR=127.0.0.1:8741 ../gateway/target/release/xensemble-unigateway"
  },
  "dependencies": {
    "@fastify/cors": "^8.3.0",
    "@fastify/websocket": "^8.2.0",
    "better-sqlite3": "^9.6.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.21.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
