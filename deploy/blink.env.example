# Optional blink-server environment (loaded by systemd via install-blink-server.sh)
# Copy to /etc/xensemble/blink.env and adjust.

# HTTP local registry for dev / air-gapped builds (boxlite pulls OCI, not docker load)
BLINK_IMAGE_REGISTRIES=localhost:5000@http

# Sandbox outbound network (default: enabled = full egress)
# BLINK_NETWORK=enabled
# BLINK_ALLOW_NET=auth.kimi.com,api.moonshot.cn,npmjs.org

# Or full BoxliteOptions JSON:
# BLINK_BOXLITE_OPTIONS={"image_registries":[{"host":"localhost:5000","transport":"http"}]}
