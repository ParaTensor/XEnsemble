NODE_ENV=production
PORT=3888
CONTROL_PLANE_PUBLIC_URL=https://xensemble.dev
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string
UNIGATEWAY_BIND_ADDR=127.0.0.1:8741
UNIGATEWAY_LOG=info
# Required in production: admin token for the UniGateway management API
UNIGATEWAY_ADMIN_TOKEN=change-me-to-a-long-random-token
# Optional: run agent/preview processes as a different OS user (requires numeric uid/gid)
RUNTIME_UID=
RUNTIME_GID=
